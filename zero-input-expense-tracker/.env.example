# === Segurança & Autenticação ===
API_SECRET_KEY=troque-por-uma-chave-forte-aleatoria-32-chars
DASHBOARD_PASSWORD=troque-por-uma-senha-forte

# === Banco de Dados ===
# SQLite (padrão local / produção leve)
DATABASE_URL=sqlite:///./finance.db
# Exemplo MySQL (migração futura):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/finance_db?charset=utf8mb4

# === Groq AI (OpenAI-Compatible) ===
GROQ_API_KEY=gsk_seu_token_aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# === Telegram Bot API ===
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
# Opcional: token secreto configurado no setWebhook para validar requests do Telegram
TELEGRAM_WEBHOOK_SECRET=

# === Regras de Negócio ===
CONFIDENCE_THRESHOLD=0.85
DEDUP_WINDOW_MINUTES=3
# Limite mensal opcional para cálculo de Burn Rate (0 = usa total de receitas do mês)
MONTHLY_BUDGET_LIMIT=0
TIMEZONE=America/Sao_Paulo
